APP_ENV=development
APP_NAME=osyn
LOG_LEVEL=info

HTTP_PORT=8080
API_HOST_PORT=8080
HTTP_TIMEOUT=15s
SHUTDOWN_GRACE=20s
API_KEY=change-me

AUTH_TOKEN_SECRET=change-me-to-a-random-secret-of-32-bytes-or-more
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
DOCUMENTS_ENCRYPTION_KEY=ZGV2LW9ubHktZG9jdW1lbnRzLWtleS1jaGFuZ2UtbWU=

AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your-api-key
AFRICASTALKING_BASE_URL=https://api.sandbox.africastalking.com
AFRICASTALKING_HTTP_TIMEOUT=15s

FETCH_INTERVAL=10s
FETCH_BATCH_SIZE=100

DATABASE_URL=postgres://osyn:osyn@postgres:5432/osyn?sslmode=disable
POSTGRES_HOST_PORT=5432
DB_MAX_CONNS=20
MIGRATIONS_DIR=db/migrations

NATS_URL=nats://nats:4222
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222
NATS_SMS_STREAM=SMS_MESSAGES
NATS_SMS_SUBJECT=sms.incoming
NATS_DLQ_STREAM=SMS_DLQ
NATS_DLQ_SUBJECT=sms.dlq
NATS_STREAM_MAX_AGE=168h
NATS_DUPLICATE_WINDOW=24h
NATS_STREAM_MAX_MSGS=1000000
NATS_STREAM_MAX_BYTES=1073741824
NATS_PUBLISH_TIMEOUT=10s

WORKER_CONCURRENCY=5
WORKER_MAX_DELIVERIES=5
WORKER_ACK_WAIT=30s
WORKER_FETCH_WAIT=2s
WORKER_PROCESS_TIMEOUT=25s
WORKER_CONSUMER_DURABLE=osyn-worker

RETRY_INITIAL_DELAY=2s
RETRY_MAX_DELAY=5m
RETRY_MAX_ATTEMPTS=5

OUTBOX_PUBLISH_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE=30s

NOTIFICATION_WORKERS=4
ACCIDENT_MAX_RADIUS_METERS=100000
EMERGENCY_CIVIL_PROTECTION_PHONE=14
EMERGENCY_GENDARMERIE_PHONE=1055
EMERGENCY_POLICE_PHONE=1548

TWILIO_DRY_RUN=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_BASE_URL=https://api.twilio.com
TWILIO_HTTP_TIMEOUT=15s

WHATSAPP_NOTIFICATIONS_ENABLED=false
OPERATOR_WHATSAPP_NUMBER=
WHATSAPP_DRY_RUN=true

CALLMEBOT_API_KEY=
CALLMEBOT_BASE_URL=https://api.callmebot.com/whatsapp.php
CALLMEBOT_HTTP_TIMEOUT=20s
